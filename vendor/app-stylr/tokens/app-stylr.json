{
  "$schema": "./app-stylr.schema.json",
  "name": "App Stylr",
  "version": "1.4.1",
  "description": "Reusable visual and interaction tokens for small web, browser-extension, and macOS products.",
  "brand": {
    "ink": "#111111",
    "charcoal": "#2E3135",
    "slate": "#49545B",
    "steel": "#647B81",
    "sage": "#83A4A3",
    "mint": "#A9CEC2"
  },
  "themes": {
    "light": {
      "canvas": "#F7FAF9",
      "sidebar": "#EEF4F2",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "border": "#D8E4E0",
      "borderStrong": "#647B81",
      "text": "#111111",
      "textMuted": "#49545B",
      "accent": "#2E3135",
      "accentText": "#FFFFFF",
      "accentStrong": "#111111",
      "link": "#315E5A",
      "focus": "#315E5A",
      "selected": "#A9CEC2",
      "selectedText": "#111111",
      "success": "#2F6B4F",
      "successSurface": "#E8F5ED",
      "warning": "#8A5A00",
      "warningSurface": "#FFF4D6",
      "danger": "#A33A32",
      "dangerSurface": "#FCEBE9",
      "info": "#315E5A",
      "infoSurface": "#E6F2EF"
    },
    "dark": {
      "canvas": "#0E0E10",
      "sidebar": "#121214",
      "surface": "#151517",
      "surfaceRaised": "#202023",
      "border": "#2A2A2E",
      "borderStrong": "#747479",
      "text": "#F5F4F3",
      "textMuted": "#A7A7AE",
      "accent": "#A9CEC2",
      "accentText": "#111111",
      "accentStrong": "#C3E3D9",
      "link": "#A9CEC2",
      "focus": "#A9CEC2",
      "selected": "#263D39",
      "selectedText": "#F5F4F3",
      "success": "#82D3A7",
      "successSurface": "#173126",
      "warning": "#F2C46F",
      "warningSurface": "#352B18",
      "danger": "#FF9189",
      "dangerSurface": "#38201F",
      "info": "#A9CEC2",
      "infoSurface": "#1C302D"
    }
  },
  "typography": {
    "families": {
      "sans": "Geist Sans",
      "mono": "Geist Mono",
      "sansFallback": "Inter, ui-sans-serif, system-ui, sans-serif",
      "monoFallback": "ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "styles": {
      "display": {
        "size": 36,
        "lineHeight": 40,
        "weight": 500,
        "letterSpacing": -1.08
      },
      "heading1": {
        "size": 28,
        "lineHeight": 34,
        "weight": 600,
        "letterSpacing": -0.56
      },
      "heading2": {
        "size": 22,
        "lineHeight": 28,
        "weight": 600,
        "letterSpacing": -0.44
      },
      "heading3": {
        "size": 17,
        "lineHeight": 23,
        "weight": 600,
        "letterSpacing": -0.17
      },
      "body": {
        "size": 15,
        "lineHeight": 23,
        "weight": 400,
        "letterSpacing": 0
      },
      "small": {
        "size": 13,
        "lineHeight": 19,
        "weight": 400,
        "letterSpacing": 0
      },
      "label": {
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "letterSpacing": 0
      },
      "monoMetadata": {
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "letterSpacing": 0
      }
    }
  },
  "spacing": {
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "24": 24,
    "32": 32,
    "48": 48,
    "64": 64
  },
  "radius": {
    "control": 4,
    "card": 8,
    "dialog": 12,
    "button": 4
  },
  "size": {
    "control": 44,
    "controlCompact": 40,
    "readingWidth": "68ch"
  },
  "motion": {
    "control": 140,
    "panel": 200,
    "syncPulse": 1200
  },
  "profiles": {
    "game": {
      "minimumViewportWidth": 1024,
      "controlHeight": 48,
      "primaryControlHeight": 58,
      "readingTextSize": 14,
      "readingLineHeight": 21,
      "labelTextSize": 12,
      "labelLineHeight": 16,
      "disclosureSummaryHeight": 76,
      "disclosureToggleSize": 32
    }
  },
  "icon": {
    "canvas": 1024,
    "square": 1024,
    "inset": 0,
    "radius": 160,
    "safeAreaPercent": 9,
    "gradient": {
      "angle": 135,
      "stops": [
        {
          "offset": 0,
          "color": "#0D0D0D"
        },
        {
          "offset": 48,
          "color": "#3B4145"
        },
        {
          "offset": 100,
          "color": "#899F98"
        }
      ]
    },
    "background": "#262626",
    "foreground": "#F5F5F5",
    "monochromeGradient": {
      "angle": 135,
      "stops": [
        {
          "offset": 0,
          "color": "#383838"
        },
        {
          "offset": 100,
          "color": "#202020"
        }
      ]
    }
  },
  "accessibility": {
    "minimumContrast": {
      "normalText": 4.5,
      "largeText": 3,
      "uiGraphics": 3
    },
    "contrastPairs": [
      {
        "name": "Light primary text",
        "foreground": "themes.light.text",
        "background": "themes.light.canvas",
        "minimum": 4.5
      },
      {
        "name": "Light muted text",
