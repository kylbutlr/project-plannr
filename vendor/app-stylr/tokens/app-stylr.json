{
  "$schema": "./app-stylr.schema.json",
  "name": "App Stylr",
  "version": "1.2.0",
  "description": "Reusable visual and interaction tokens for small web, browser-extension, and macOS products.",
  "brand": {
    "ink": "#111111",
    "charcoal": "#2E3135",
    "slate": "#49545B",
    "steel": "#647B81",
    "sage": "#83A4A3",
    "mint": "#A9CEC2"
  },
  "themes": {
    "light": {
      "canvas": "#F7FAF9",
      "sidebar": "#EEF4F2",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "border": "#D8E4E0",
      "borderStrong": "#647B81",
      "text": "#111111",
      "textMuted": "#49545B",
      "accent": "#2E3135",
      "accentText": "#FFFFFF",
      "accentStrong": "#111111",
      "link": "#315E5A",
      "focus": "#315E5A",
      "selected": "#A9CEC2",
      "selectedText": "#111111",
      "success": "#2F6B4F",
      "successSurface": "#E8F5ED",
      "warning": "#8A5A00",
      "warningSurface": "#FFF4D6",
      "danger": "#A33A32",
      "dangerSurface": "#FCEBE9",
      "info": "#315E5A",
      "infoSurface": "#E6F2EF"
    },
    "dark": {
      "canvas": "#0E0E10",
      "sidebar": "#121214",
      "surface": "#151517",
      "surfaceRaised": "#202023",
      "border": "#2A2A2E",
      "borderStrong": "#747479",
      "text": "#F5F4F3",
      "textMuted": "#A7A7AE",
      "accent": "#A9CEC2",
      "accentText": "#111111",
      "accentStrong": "#C3E3D9",
      "link": "#A9CEC2",
      "focus": "#A9CEC2",
      "selected": "#263D39",
      "selectedText": "#F5F4F3",
      "success": "#82D3A7",
      "successSurface": "#173126",
      "warning": "#F2C46F",
      "warningSurface": "#352B18",
      "danger": "#FF9189",
      "dangerSurface": "#38201F",
      "info": "#A9CEC2",
      "infoSurface": "#1C302D"
    }
  },
  "typography": {
    "families": {
      "sans": "Geist Sans",
      "mono": "Geist Mono",
      "sansFallback": "Inter, ui-sans-serif, system-ui, sans-serif",
      "monoFallback": "ui-monospace, SFMono-Regular, Consolas, monospace"
    },
    "styles": {
      "display": {
        "size": 40,
        "lineHeight": 44,
        "weight": 700,
        "letterSpacing": -0.8
      },
      "heading1": {
        "size": 32,
        "lineHeight": 38,
        "weight": 700,
        "letterSpacing": -0.64
      },
      "heading2": {
        "size": 26,
        "lineHeight": 32,
        "weight": 650,
        "letterSpacing": -0.52
      },
      "heading3": {
        "size": 20,
        "lineHeight": 26,
        "weight": 600,
        "letterSpacing": -0.4
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "weight": 400,
        "letterSpacing": 0
      },
      "small": {
        "size": 14,
        "lineHeight": 20,
        "weight": 400,
        "letterSpacing": 0
      },
      "label": {
        "size": 13,
        "lineHeight": 16,
        "weight": 500,
        "letterSpacing": 0
      },
      "monoMetadata": {
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "letterSpacing": 0
      }
    }
  },
  "spacing": {
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "24": 24,
    "32": 32,
    "48": 48,
    "64": 64
  },
  "radius": {
    "control": 8,
    "card": 12,
    "dialog": 16,
    "button": 9
  },
  "size": {
    "control": 44,
    "controlCompact": 40,
    "readingWidth": "68ch"
  },
  "motion": {
    "control": 160,
    "panel": 240,
    "syncPulse": 1200
  },
  "profiles": {
    "game": {
      "minimumViewportWidth": 1024,
      "controlHeight": 48,
      "primaryControlHeight": 58,
      "readingTextSize": 14,
      "readingLineHeight": 21,
      "labelTextSize": 12,
      "labelLineHeight": 16,
      "disclosureSummaryHeight": 76,
      "disclosureToggleSize": 32
    }
  },
  "icon": {
    "canvas": 1024,
    "square": 840,
    "inset": 92,
    "radius": 190,
    "safeAreaPercent": 9,
    "gradient": {
      "angle": 135,
      "stops": [
        {
          "offset": 0,
          "color": "#0D0D0D"
        },
        {
          "offset": 48,
          "color": "#3B4145"
        },
        {
          "offset": 100,
          "color": "#899F98"
        }
      ]
    }
  },
  "accessibility": {
    "minimumContrast": {
      "normalText": 4.5,
      "largeText": 3,
      "uiGraphics": 3
    },
    "contrastPairs": [
      {
        "name": "Light primary text",
        "foreground": "themes.light.text",
        "background": "themes.light.canvas",
        "minimum": 4.5
      },
      {
        "name": "Light muted text",
        "foreground": "themes.light.textMuted",
        "background": "themes.light.surface",
        "minimum": 4.5
      },
      {
        "name": "Light primary action",
        "foreground": "themes.light.accentText",
        "background": "themes.light.accent",
        "minimum": 4.5
      },
      {
        "name": "Light selected state",
        "foreground": "themes.light.selectedText",
        "background": "themes.light.selected",
        "minimum": 4.5
      },
      {
        "name": "Light success message",
        "foreground": "themes.light.success",
        "background": "themes.light.successSurface",
        "minimum": 4.5
      },
      {
        "name": "Light warning message",
        "foreground": "themes.light.warning",
        "background": "themes.light.warningSurface",
        "minimum": 4.5
      },
      {
        "name": "Light danger message",
        "foreground": "themes.light.danger",
        "background": "themes.light.dangerSurface",
        "minimum": 4.5
      },
      {
        "name": "Light info message",
        "foreground": "themes.light.info",
        "background": "themes.light.infoSurface",
        "minimum": 4.5
      },
      {
        "name": "Dark primary text",
        "foreground": "themes.dark.text",
        "background": "themes.dark.canvas",
        "minimum": 4.5
      },
      {
        "name": "Dark muted text",
        "foreground": "themes.dark.textMuted",
        "background": "themes.dark.surface",
        "minimum": 4.5
      },
      {
        "name": "Dark primary action",
        "foreground": "themes.dark.accentText",
        "background": "themes.dark.accent",
        "minimum": 4.5
      },
      {
        "name": "Dark selected state",
        "foreground": "themes.dark.selectedText",
        "background": "themes.dark.selected",
        "minimum": 4.5
      },
      {
        "name": "Dark success message",
        "foreground": "themes.dark.success",
        "background": "themes.dark.successSurface",
        "minimum": 4.5
      },
      {
        "name": "Dark warning message",
        "foreground": "themes.dark.warning",
        "background": "themes.dark.warningSurface",
        "minimum": 4.5
      },
      {
        "name": "Dark danger message",
        "foreground": "themes.dark.danger",
        "background": "themes.dark.dangerSurface",
        "minimum": 4.5
      },
      {
        "name": "Dark info message",
        "foreground": "themes.dark.info",
        "background": "themes.dark.infoSurface",
        "minimum": 4.5
      }
    ]
  }
}
