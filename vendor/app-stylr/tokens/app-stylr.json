        "name": "Dark info message",
        "foreground": "themes.dark.info",
        "background": "themes.dark.infoSurface",
        "minimum": 4.5
      },
      {
        "name": "Light quiet success",
        "foreground": "themes.light.success",
        "background": "themes.light.surface",
        "minimum": 4.5
      },
      {
        "name": "Light quiet warning",
        "foreground": "themes.light.warning",
        "background": "themes.light.surface",
        "minimum": 4.5
