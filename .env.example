# Copy to .env locally. Never commit .env or paste secrets into chat.
PLANNR_MODE=private
# password (default), or none for standalone loopback use only.
PLANNR_AUTH_MODE=password
PROJECT_PLANNR_PORT=4205
PLANNR_ORIGIN=http://127.0.0.1:4205
# Unique, password-manager-generated secret, 16 to 256 characters. Server only.
PLANNR_PASSWORD=
# Only the new schema-only development branch is enabled at this milestone.
PLANNR_DATABASE_BRANCH=development
PLANNR_DATABASE_HOST=
DATABASE_URL=
# Optional direct development URL for migration. Host is checked separately.
PLANNR_MIGRATION_HOST=
MIGRATION_DATABASE_URL=
# Without DATABASE_URL, private mode uses this ignored, owner-readable file.
PLANNR_DATA_FILE=data/workspace.json
